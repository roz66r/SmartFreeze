<resources>
    <style name="SmartFreezeTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#32DDFB</item>
        <item name="android:windowBackground">#050B14</item>
        <item name="android:statusBarColor">#050B14</item>
        <item name="android:navigationBarColor">#050B14</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:buttonStyle">@style/SmartFreezeButton</item>
        <item name="android:editTextStyle">@style/SmartFreezeEditText</item>
        <item name="android:checkboxStyle">@style/SmartFreezeCheckBox</item>
        <item name="android:radioButtonStyle">@style/SmartFreezeRadioButton</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="SmartFreezeDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#32DDFB</item>
        <item name="android:windowBackground">@drawable/sf_dialog_background</item>
        <item name="android:textColorPrimary">#F1FAFF</item>
        <item name="android:textColorSecondary">#A8BDCC</item>
        <item name="android:buttonStyle">@style/SmartFreezeButton</item>
        <item name="android:editTextStyle">@style/SmartFreezeEditText</item>
        <item name="android:checkboxStyle">@style/SmartFreezeCheckBox</item>
        <item name="android:radioButtonStyle">@style/SmartFreezeRadioButton</item>
    </style>
    <style name="SmartFreezeButton" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#EAFBFF</item>
        <item name="android:backgroundTint">#12394D</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
    <style name="SmartFreezeEditText" parent="android:style/Widget.Material.EditText">
        <item name="android:textColor">#F2FAFF</item>
        <item name="android:textColorHint">#8DA5B5</item>
        <item name="android:backgroundTint">#32DDFB</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="SmartFreezeCheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:buttonTint">#32DDFB</item>
        <item name="android:textColor">#EAFBFF</item>
    </style>
    <style name="SmartFreezeRadioButton" parent="android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:buttonTint">#32DDFB</item>
        <item name="android:textColor">#EAFBFF</item>
    </style>
</resources>
